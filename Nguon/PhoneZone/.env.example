# Sao chep file nay thanh .env (file .env da duoc git ignore) va dien key THAT cua ban.
# Gemini Free Tier (khuyen nghi cho demo). Khi bo trong key, ai-service van dung fallback mien phi.
# Gemini ho tro OpenAI-compatible Chat Completions nen khong can sua Java code.
AI_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
AI_MODEL=gemini-3.7-flash

# MoMo: lay Partner code, Access key, Secret key tu tai khoan sandbox MoMo cua ban.
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Callback MoMo phai la URL HTTPS cong khai khi test thanh toan that, vi du ngrok.
MOMO_IPN_URL=https://your-subdomain.ngrok-free.app/api/payments/momo/ipn
MOMO_REDIRECT_URL=http://localhost:8080/cart.html

# VNPay Sandbox. Dang ky tai sandbox.vnpayment.vn/devreg/ de nhan 2 key nay.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8084/api/payments/vnpay/return

# ZaloPay Sandbox (lay tu ZaloPay Merchant Sandbox, khong commit file .env that)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=http://localhost:8084/api/payments/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:8080/history.html?payment=zalopay
